  canShare: 0
  adaSuggestion: 1
  adaHint: La imagen es demasiado perfecta y los textos del fondo no se leen. IA.
  introSpeaker: 0
  introDialogue: "Nivel de im\xE1genes. Observa los detalles, no solo la impresi\xF3n
