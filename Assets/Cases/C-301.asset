  evidenceSprite: {fileID: 21300000, guid: 489c96a73bcb87242a0bb22f05c8414b, type: 3}
  findings:
  - tool: 0
    result: "Los textos de las pantallas del fondo son ilegibles o est\xE1n mal escritos:
      t\xEDpico de im\xE1genes generadas."
    isRelevant: 1
  - tool: 4
    result: "Sin datos EXIF de c\xE1mara. Resoluci\xF3n 1408\xD7768, habitual en
